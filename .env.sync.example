# Production (SSH)
PROD_HOST=ssh-alias
PROD_PATH=/path/to/wordpress/
PROD_URL=https://example.com

# Local (WordPress root)
LOCAL_PATH=/path/to/wordpress/
LOCAL_URL=https://example.test

# Optional SSH override.
# Leave empty to use ~/.ssh/config for host/user/key/port.
# SSH_KEY=/path/to/private_key
# SSH_PORT=22

# WP-CLI options: 1=with --allow-root, 0=without
LOCAL_WP_ALLOW_ROOT=0
PROD_WP_ALLOW_ROOT=1

# temp dir for SQL dump
TMP_DIR=/tmp

# rsync backup (recommended: keep enabled)
# BACKUP_ENABLE=1
# BACKUP_KEEP=3
#
# If omitted, defaults to:
# BACKUP_DIR_LOCAL=${LOCAL_PATH parent}/.sync-backups
# BACKUP_DIR_PROD=${PROD_PATH parent}/.sync-backups
# For production, prefer a non-public path when possible.
# BACKUP_DIR_LOCAL=/path/to/local/backups
# BACKUP_DIR_PROD=/path/to/prod/backups
